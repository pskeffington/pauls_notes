# Editing conventions only; scientific files must not be reformatted to alter frozen evidence.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,rs}]
indent_style = space
indent_size = 4

[*.{R,r,sh,yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
